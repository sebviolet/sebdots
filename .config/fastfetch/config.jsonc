{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/master/dev/doc/json_schema.json",
  "logo": {
    "source": "$HOME/Pictures/Wallpapers/*",
    "type": "sixel",
    "recache": true,
    "height": 18,
    "width": 50,
    "position": "left"
  },
  "general": {
    "thread": true
  },
  "modules": [
	{
	    "type": "title",
	    "format": "┌──────────────── Hardware ───────────────┐"
	},
	{
	    "type": "title",
	    "key": " PC"
	},
	{
	    "type": "cpu",
	    "key": "│ ├󰍛 CPU",
	    "format": "{1}"
	},
	{
	    "type": "gpu",
	    "key": "│ ├󰍛 GPU"
	},
	{
	    "type": "memory",
	    "key": "└ └󰍛 Memory"
	},
	{
	    "type": "title",
	    "format": "└─────────────────────────────────────────┘"
	},
	{
	    "type": "title",
	    "format": "┌──────────────── Software ───────────────┐"
	},
	{
	    "type": "os",
	    "key": " OS"
	},
	{
	    "type": "kernel",
	    "key": "│ ├ Kernel"
	},
	{
	    "type": "packages",
	    "key": "│ ├󰏖 Packages"
	},
	{
	    "type": "shell",
	    "key": "│ ├ Shell"
	},
	{
	    "type": "terminal",
	    "key": "│ ├ Terminal"
	},
	{
	    "type": "command",
	    "key": "│ ├ OS Age",
	    "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
	},
	{
	    "type": "uptime",
	    "key": "└ └ Uptime"
	},
	{
	    "type": "lm",
	    "key": "│ ├ LM"
	},
	{
	    "type": "wm",
	    "key": "│ ├ WM"
	},
	{
	    "type": "gpu",
	    "key": "│ ├󰍛 GPU Driver",
	    "format": "{3}"
	},
	{
	    "type": "BIOS",
	    "key": "└ └󰍛 BIOS"
	},
	{
	    "type": "title",
	    "format": "└─────────────────────────────────────────┘"
	},
  ]
}
